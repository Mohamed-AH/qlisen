# Server Configuration
NODE_ENV=development
PORT=5001

# Whisper Mode Selection (choose ONE):
# Option 1: Local Testing - Docker Whisper on localhost
USE_REMOTE_WHISPER=true
WHISPER_URL=http://localhost:5000

# Option 2: Production - Remote Whisper (your PC via Cloudflare tunnel)
# USE_REMOTE_WHISPER=true
# WHISPER_URL=https://your-tunnel-url.trycloudflare.com

# Option 3: Local Whisper (nodejs-whisper on same server)
# USE_LOCAL_WHISPER=true
# WHISPER_MODEL=base

# Option 4: OpenAI Whisper API
# USE_REMOTE_WHISPER=false
# USE_LOCAL_WHISPER=false
# OPENAI_API_KEY=sk-your-api-key-here

# Email Service (SendGrid)
# Get free API key from: https://sendgrid.com
SENDGRID_API_KEY=your-sendgrid-api-key
FROM_EMAIL=noreply@qlisen.com

# Frontend URL (for email links)
# Local testing:
FRONTEND_URL=http://localhost:3000
# Production:
# FRONTEND_URL=https://qlisen.onrender.com

# Database (optional - for session storage)
# DATABASE_URL=mongodb://localhost:27017/qlisen
